# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# --- Individual-level trial data: never commit ---------------------------------
# IMiC participant data is governed by the consortium and the three trials'
# data-access agreements. Everything under data/ is excluded, then the vetted
# aggregate inputs are re-included explicitly.
data/**
!data/untargeted_annotation/
!data/untargeted_annotation/**
!data/milq_age_specific_cutoffs_clean.RDS

# The harmonized analytic dataset, wherever it turns up.
*merged_analysis_datasets*
*analysis_datasets*

# Saved ggplot objects embed their plot data, which can include per-participant rows.
# Only Fig. 1A's classifier summary (cross-validated AUCs by study, visit and arm) ships.
figure-data/*
!figure-data/SL_vim_plot_data.RDS

# Pipeline outputs that hold participant-level rows or embedded model objects.
# The raw run_bioTMLE() results carry each participant's covariates and outcomes;
# only the cleaned estimate tables (*_clean.RDS) and the stripped files already
# tracked here are safe to publish.
results/imic_*
results/*growth_outcomes_dataset*
results/growth_impl_*
results/growth_outlier_*
results/SL_*
results/temp_*
results/*intervention_effects_results*.RDS
!results/*_clean.RDS

# --- Generated outputs ----------------------------------------------------------
figures/
large-file-results/
output/
logs/
Rplots.pdf
*.log

# Large feature-level result families: aggregate, but 15–250 MB each.
results/blood_compartment_*
results/combined_intervention_effects_*
results/*untargeted*
results/*_ATE.RDS
results/*_MN.RDS
results/mummichog_*/

# MetaboAnalystR writes rendered report files beside its result CSVs.
results/**/*.html
results/**/*.js
results/**/*.png
results/**/*.pdf
results/**/*.qs

# Local tool files
.claude/
.release-marker

# OS / Office files
.DS_Store
Thumbs.db
desktop.ini
~$*
